  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "server": "tsx watch server/src/index.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "test:enquiries": "tsx --test tests/enquiries.test.ts",
    "test:categories": "tsx --test tests/categories.test.ts",
    "test:services": "tsx --test tests/services.test.ts",
    "test:reviews": "tsx --test tests/reviews.test.ts",
    "test:pillars": "tsx --test tests/pillars.test.ts",
    "test:reels": "tsx --test tests/reels.test.ts",
    "test:settings": "tsx --test tests/settings.test.ts",
    "test": "tsx --test tests/enquiries.test.ts tests/categories.test.ts tests/services.test.ts tests/reviews.test.ts tests/pillars.test.ts tests/reels.test.ts tests/settings.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/multer": "^2.3.0",

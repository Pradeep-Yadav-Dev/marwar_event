    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "lucide-react": "^1.67.0",
    "multer": "^2.5.0",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-toastify": "^11.2.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}

// Prisma Schema for MySQL / phpMyAdmin Database
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  hindi       String?
  description String   @db.Text
  image       String   @db.VarChar(500)
  status      String   @default("active") // "active" | "draft"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id        Int      @id @default(autoincrement())
  name      String
  event     String
  quote     String   @db.Text
  rating    Int      @default(5)
  initials  String?
  status    String   @default("active") // "active" | "draft"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SignaturePillar {
  id        Int      @id @default(autoincrement())
  num       String   @default("01")
  hindi     String?
  title     String
  tag       String?
  text      String   @db.Text
  icon      String   @default("Landmark")
  status    String   @default("active") // "active" | "draft"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  category    String    @default("Wedding")
  price       String
  shortDesc   String    @db.Text
  description String    @db.Text
  image       String    @db.VarChar(500)
  icon        String    @default("Sparkles")
  features    String    @db.Text // Comma separated or JSON array of highlights
  isPopular   Boolean   @default(false)
  status      String    @default("active") // "active" | "draft"
  metaTitle   String?
  metaDesc    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  inquiries   Inquiry[]
}

model Inquiry {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  phone       String
  serviceId   Int?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceName String?
  eventDate   String?
  guestCount  String?
  budget      String?
  message     String   @db.Text
  status      String   @default("PENDING") // PENDING, CONTACTED, CONFIRMED, COMPLETED, CANCELLED
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id          Int      @id @default(autoincrement())
  siteName    String   @default("Marwar Events & Services")
  tagline     String   @default("Crafting Royal & Timeless Celebrations in Rajasthan")
  phone       String   @default("+91 98765 43210")
  email       String   @default("info@marwarevents.com")
  address     String   @default("Pal Road, Jodhpur, Rajasthan 342008")
  metaTitle   String   @default("Marwar Events - Royal Destination Weddings & Event Management")
  metaDesc    String   @default("Premier event planning and wedding management in Marwar, Rajasthan.")
  updatedAt   DateTime @updatedAt
}


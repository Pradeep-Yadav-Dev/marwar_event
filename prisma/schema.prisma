// Prisma Schema for MySQL / phpMyAdmin Database
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  hindi       String?
  description String   @db.Text
  image       String   @db.VarChar(500)
  status      String   @default("active") // "active" | "draft"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id        Int      @id @default(autoincrement())
  name      String
  event     String
  quote     String   @db.Text
  rating    Int      @default(5)
  initials  String?
  status    String   @default("active") // "active" | "draft"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SignaturePillar {
  id        Int      @id @default(autoincrement())
  num       String   @default("01")
  hindi     String?
  title     String
  tag       String?
  text      String   @db.Text
  icon      String   @default("Landmark")
  status    String   @default("active") // "active" | "draft"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InstagramReel {
  id        Int      @id @default(autoincrement())
  handle    String   @default("marwarevent")
  url       String   @db.VarChar(500)
  caption   String   @db.Text
  sortOrder Int      @default(0)
  status    String   @default("active") // "active" | "inactive"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  category    String    @default("Wedding")
  price       String
  shortDesc   String    @db.Text
  description String    @db.Text
  image       String    @db.VarChar(500)
  icon        String    @default("Sparkles")
  features    String    @db.Text // Comma separated or JSON array of highlights
  isPopular   Boolean   @default(false)
  status      String    @default("active") // "active" | "draft"
  metaTitle   String?
  metaDesc    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  inquiries   Inquiry[]
}

model Inquiry {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  phone       String
  serviceId   Int?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceName String?
  eventDate   String?
  guestCount  String?
  budget      String?
  message     String   @db.Text
  status      String   @default("PENDING") // PENDING, CONTACTED, CONFIRMED, COMPLETED, CANCELLED
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id              Int      @id @default(autoincrement())
  // Branding
  siteName        String   @default("Marwar Event")
  tagline         String   @default("Royal Rajasthani Celebrations")
  logo            String   @default("") // /uploads/settings/... (empty = text logo)
  favicon         String   @default("") // /uploads/settings/... (empty = /favicon.ico)
  // SEO / Meta
  metaTitle       String   @default("")
  metaDesc        String?  @db.Text
  metaKeywords    String?  @db.Text
  ogImage         String   @default("")
  canonicalUrl    String   @default("")
  // Contact
  email           String   @default("")
  phone           String   @default("")
  whatsapp        String   @default("")
  address         String?  @db.Text
  // Footer
  footerAbout     String?  @db.Text
  footerCopyright String   @default("")
  socialLinks     String?  @db.Text // JSON: [{ platform, url }]
  updatedAt       DateTime @updatedAt
}

